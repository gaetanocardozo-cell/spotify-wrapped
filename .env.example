# Copy to .env.local and fill in.  .env.local is gitignored; this file is not.
#
#   cp .env.example .env.local
#
# Generate the two secrets at the bottom with the commands shown.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# "pglite"   = local Postgres-in-WASM, zero setup, data in ./.pglite  (dev default)
# "postgres" = Supabase / any Postgres, requires DATABASE_URL below
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=.pglite

# Supabase: Dashboard -> Connect -> "Direct connection" panel -> Session pooler tab.
# Use the SESSION POOLER (port 5432) or transaction pooler (6543) — NOT the
# "Direct connection" string, which is IPv6-only and fails from Vercel.
# Remember to substitute your actual password for [YOUR-PASSWORD].
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Spotify OAuth
# ---------------------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard (tick "Web API").
# Register this exact redirect URI on the app:
#     http://127.0.0.1:3000/api/auth/callback
# Spotify rejects "localhost" — it must be the literal 127.0.0.1.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: pin the redirect URI. Leave unset to derive it from the request,
# which is what lets the same build work locally and on Vercel.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback

# ---------------------------------------------------------------------------
# Secrets — generate these, don't invent them
# ---------------------------------------------------------------------------
# Encrypts Spotify refresh tokens at rest.   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Guards the collector endpoint so only the scheduler can run it.
#                                            openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# All day/hour bucketing happens in this zone, so "days" match your lived days.
APP_TIMEZONE=America/Bogota
